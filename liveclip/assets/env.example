# Copy to .env next to config.yaml (`liveclip init` does it). Environment variables already set win.
# Never commit .env.

# Anthropic API key. Optional: without it LiveClip uses the local `claude` CLI (Claude Code, logged in).
ANTHROPIC_API_KEY=

# Alibaba Cloud Bailian / DashScope key for ASR (Beijing region). The international key is optional.
DASHSCOPE_API_KEY=
DASHSCOPE_API_KEY_INTL=

# Optional overrides
# LIVECLIP_CONFIG=/path/to/config.yaml
# LIVECLIP_HOME=/path/to/workspace
# CLAUDE_LEAN=0            # use the full Claude Code system prompt/tools for `claude -p` calls (more expensive)
# CUT_ENCODER=vt           # macOS VideoToolbox hardware encoder (~10% faster, slightly lower quality)
# LIVECLIP_VISION=none     # disable face detection
# LIVECLIP_EYES=/path/to/eyes_open   # prebuilt macOS Vision helper
